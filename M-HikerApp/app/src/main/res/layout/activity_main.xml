<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/kemxanh"
    tools:context="MhikeApp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text_add_hike_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Hike"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/deepGreen"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_text_hike_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hike Name (Required)"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_border"
            android:padding="12dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/text_add_hike_header"/>

        <EditText
            android:id="@+id/edit_text_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location (Required)"
            android:inputType="textPostalAddress"
            android:background="@drawable/edit_text_border"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edit_text_hike_name"/>

        <TextView
            android:id="@+id/text_hike_date_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hike Date (Required)"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edit_text_location"/>

        <Button
            android:id="@+id/button_pick_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Date"
            app:backgroundTint="@null"
            android:textColor="@color/white"
            style="@style/RoundedButton"
            android:backgroundTint="@color/primaryGreen"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_hike_date_label"/>

        <TextView
            android:id="@+id/text_selected_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="No date selected"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/button_pick_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/button_pick_date"
            app:layout_constraintBottom_toBottomOf="@id/button_pick_date"
            android:gravity="center_vertical"/>

        <TextView
            android:id="@+id/text_parking_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Is parking available?"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/button_pick_date"/>

        <RadioGroup
            android:id="@+id/radio_group_parking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/text_parking_label">
            <RadioButton
                android:id="@+id/radio_parking_yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/radio_parking_no"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:text="No" />
        </RadioGroup>

        <EditText
            android:id="@+id/edit_text_length"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Length of hike (Required) - e.g., 5.5 km"
            android:inputType="numberDecimal"
            android:background="@drawable/edit_text_border"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/radio_group_parking"/>

        <TextView
            android:id="@+id/text_difficulty_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Difficulty?"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edit_text_length"/>

        <RadioGroup
            android:id="@+id/radio_group_difficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/text_difficulty_label">
            <RadioButton
                android:id="@+id/radio_difficulty_easy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Easy"/>
            <RadioButton
                android:id="@+id/radio_difficulty_moderate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moderate"
                android:checked="true"
                android:layout_marginStart="16dp"/>
            <RadioButton
                android:id="@+id/radio_difficulty_hard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard"
                android:layout_marginStart="16dp"/>
        </RadioGroup>

        <EditText
            android:id="@+id/edit_text_hike_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type: Day Hiking, Thru-Hiking, Section (...)"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_border"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/radio_group_difficulty"/>

        <EditText
            android:id="@+id/edit_text_scenic_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Scenic Points of Interest (Separate with commas)"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:background="@drawable/edit_text_border"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edit_text_hike_type"/>

        <EditText
            android:id="@+id/edit_text_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description (Optional)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:background="@drawable/edit_text_border"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edit_text_scenic_points"/>

        <Button
            android:id="@+id/add_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primaryGreen"
            android:padding="14dp"
            android:text="Add Hike"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/edit_text_description" />

        <Button
            android:id="@+id/button_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@android:color/transparent"
            android:padding="14dp"
            android:text="Cancel"
            android:textColor="@color/Deepred"            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/add_btn" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>