<resources>

    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">

    </style>

    <style name="GreenTextStyle">
        <item name="android:textColor">#008000</item>
        <item name="android:textSize">18dp</item>
    </style>

    <style name="GrayTextStyle">
        <item name="android:textColor">#4A4E50</item>
        <item name="android:textSize">18dp</item>
    </style>

    <style name="RedTextStyle">
        <item name="android:textColor">#FF0000</item>
    </style>

    <style name="RoundedButton" parent="Widget.MaterialComponents.Button">
        <!-- ... giữ các thuộc tính khác cho border radius, màu sắc, v.v. ... -->
        <item name="android:background">@drawable/bg_button_rounded</item>
        <item name="android:minWidth">0dp</item>   <!-- Đặt về 0dp hoặc xóa dòng này -->
        <item name="android:minHeight">0dp</item>  <!-- Đặt về 0dp hoặc xóa dòng này -->
        <item name="android:paddingStart">12dp</item> <!-- Giảm padding nếu muốn -->
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item> <!-- Có thể giảm cỡ chữ để nút nhỏ hơn -->
    </style>

